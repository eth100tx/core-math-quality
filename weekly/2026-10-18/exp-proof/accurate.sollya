prec=300!;
c0 = 0x1p+0;
c1 = 0x1p-1 + 0x1.712f72ecec2cfp-99;
c2 = 0x1.5555555555555p-3 + 0x1.5555555554d07p-57;
c3 = 0x1.5555555555555p-5 + 0x1.55194d28275dap-59;
c4 = 0x1.1111111111111p-7 + 0x1.12faa0e1c0f7bp-63;
c5 = 0x1.6c16c16da6973p-10 - 0x1.4ba45ab25d2a3p-64;
c6 = 0x1.a01a019eb7f31p-13 - 0x1.9091d845ecd36p-67;
q = c0 + c1*x + c2*x^2 + c3*x^3 + c4*x^4 + c5*x^5 + c6*x^6;
d = [-90901b-30,90901b-30];
supnorm(1+x*q,exp(x),d,absolute,1b-40);
